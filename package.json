{
  "name": "connectome-cook",
  "version": "0.0.1",
  "description": "Recipes in, Docker images out. CLI that takes a connectome-host recipe and cooks it into a deployable Docker artifact bundle.",
  "type": "module",
  "bin": {
    "cook": "./bin/cook",
    "connectome": "./bin/connectome"
  },
  "scripts": {
    "dev": "bun bin/cook",
    "build": "tsc",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "docs/held-candidates.md",
    "docs/deployment-manifest.md",
    "docs/secret-files.md",
    "docs/host-engines.md",
    "docs/host-user-unit.md",
    "docs/host-layout.md",
    "docs/host-credentials.md"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "mri": "^1.2.0",
    "picocolors": "^1.1.1",
    "prompts": "^2.4.2",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@types/node": "^22.0.0",
    "@types/prompts": "^2.4.9",
    "@types/semver": "^7.8.0",
    "typescript": "^5.7.0"
  }
}
